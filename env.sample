# =============================================================================
# eSign — all-in-one Docker image only (docker/Dockerfile stage: all-in-one)
# Postgres runs inside the same container; data lives under /app/data.
# Dokploy: mount a persistent volume on /app/data. Do not set DATABASE_URL vars.
# Full options: .env.example
# =============================================================================

# [[Container / proxy]]
PORT=3000
NEXT_PUBLIC_WEBAPP_URL="https://your-domain.com"
NEXT_PRIVATE_INTERNAL_WEBAPP_URL="https://your-domain.com"

# [[Embedded PostgreSQL]]
# Alphanumeric password strongly recommended (used inside connection URL).
POSTGRES_USER="documenso"
POSTGRES_DB="documenso"
POSTGRES_PASSWORD=""

# [[Auth & crypto]]
NEXTAUTH_SECRET=""
NEXT_PRIVATE_ENCRYPTION_KEY=""
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=""

# [[PDF signing — mount cert to this path or use NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS]]
NEXT_PRIVATE_SIGNING_TRANSPORT="local"
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH="/opt/documenso/cert.p12"
NEXT_PRIVATE_SIGNING_PASSPHRASE=""

# [[SMTP]]
NEXT_PRIVATE_SMTP_TRANSPORT="smtp-auth"
NEXT_PRIVATE_SMTP_HOST="smtp-mail.outlook.com"
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_SECURE="false"
NEXT_PRIVATE_SMTP_USERNAME=""
NEXT_PRIVATE_SMTP_PASSWORD=""
NEXT_PRIVATE_SMTP_FROM_NAME="eSign"
NEXT_PRIVATE_SMTP_FROM_ADDRESS=""
