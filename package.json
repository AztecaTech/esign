{
  "private": true,
  "name": "@documenso/root",
  "version": "2.8.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm run translate:compile && turbo run dev --filter=@documenso/remix",
    "dev:remix": "pnpm run translate:compile && turbo run dev --filter=@documenso/remix",
    "dev:docs": "turbo run dev --filter=@documenso/docs",
    "dev:openpage-api": "turbo run dev --filter=@documenso/openpage-api",
    "start": "turbo run start --filter=@documenso/remix --filter=@documenso/docs --filter=@documenso/openpage-api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx}\"",
    "prepare": "husky && husky install || true",
    "commitlint": "commitlint --edit",
    "clean": "turbo run clean && rimraf node_modules",
    "d": "pnpm run dx && pnpm run translate:compile && pnpm run dev",
    "dx": "pnpm install --frozen-lockfile && pnpm run dx:up && pnpm run prisma:migrate-dev && pnpm run prisma:seed",
    "dx:up": "docker compose -f docker/development/compose.yml up -d",
    "dx:down": "docker compose -f docker/development/compose.yml down",
    "docker:local:up": "docker compose -f docker/local/compose.yml up -d --build",
    "docker:local:down": "docker compose -f docker/local/compose.yml down",
    "docker:local:logs": "docker compose -f docker/local/compose.yml logs -f web",
    "docker:prod:up": "docker compose -f docker/production/compose.yml --env-file .env up -d --build",
    "docker:prod:down": "docker compose -f docker/production/compose.yml down",
    "docker:runner:build": "docker build -f docker/Dockerfile --target runner -t esign:web .",
    "docker:all-in-one:build": "docker build -f docker/Dockerfile --target all-in-one -t esign:all-in-one .",
    "ci": "turbo run build --filter=@documenso/remix && turbo run test:e2e",
    "prisma:generate": "pnpm run with:env -- pnpm --filter @documenso/prisma run prisma:generate",
    "prisma:migrate-dev": "pnpm run with:env -- pnpm --filter @documenso/prisma run prisma:migrate-dev",
    "prisma:migrate-deploy": "pnpm run with:env -- pnpm --filter @documenso/prisma run prisma:migrate-deploy",
    "prisma:migrate-reset": "pnpm run with:env -- pnpm --filter @documenso/prisma run prisma:migrate-reset",
    "prisma:seed": "pnpm run with:env -- pnpm --filter @documenso/prisma run prisma:seed",
    "prisma:studio": "pnpm run with:env -- pnpm --filter @documenso/prisma run prisma:studio",
    "with:env": "dotenv -e .env -e .env.local --",
    "reset:hard": "pnpm run clean && pnpm install && pnpm run prisma:generate",
    "precommit": "pnpm install && git add package.json pnpm-lock.yaml",
    "trigger:dev": "pnpm run with:env -- npx trigger-cli dev --handler-path=\"/api/jobs\"",
    "inngest:dev": "inngest dev -u http://localhost:3000/api/jobs",
    "make:version": "pnpm --filter @documenso/remix exec npm version patch --no-git-tag-version -m \"v%s\"",
    "translate": "pnpm run translate:extract && pnpm run translate:compile",
    "translate:extract": "lingui extract --clean",
    "translate:compile": "lingui compile"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@datadog/pprof": "^5.13.5",
    "@lingui/cli": "^5.6.0",
    "@prisma/client": "^6.19.0",
    "@trpc/client": "11.8.1",
    "@trpc/react-query": "11.8.1",
    "@trpc/server": "11.8.1",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@ts-rest/serverless": "^3.52.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "inngest-cli": "^1.16.1",
    "lint-staged": "^16.2.7",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "5.4.296",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "playwright": "1.56.1",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "prisma-extension-kysely": "^3.0.0",
    "prisma-json-types-generator": "^3.6.2",
    "prisma-kysely": "^2.3.0",
    "rimraf": "^6.1.2",
    "superjson": "^2.2.5",
    "syncpack": "^14.0.0-alpha.27",
    "turbo": "^1.13.4",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "zod-openapi": "^4.2.4",
    "zod-prisma-types": "3.3.5"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "3.0.81",
    "@documenso/prisma": "workspace:*",
    "@libpdf/core": "^0.3.3",
    "@lingui/conf": "^5.6.0",
    "@lingui/core": "^5.6.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "ai": "^5.0.104",
    "cron-parser": "^5.5.0",
    "luxon": "^3.7.2",
    "posthog-node": "4.18.0",
    "react": "^18",
    "typescript": "5.6.2",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "strictPeerDependencies": false,
    "nodeLinker": "hoisted",
    "patchedDependencies": {
      "@ai-sdk/google-vertex@3.0.81": "patches/@ai-sdk+google-vertex+3.0.81.patch"
    }
  },
  "overrides": {
    "lodash": "4.17.23",
    "pdfjs-dist": "5.4.296",
    "typescript": "5.6.2",
    "zod": "$zod",
    "fumadocs-mdx": {
      "zod": "^4.3.5"
    }
  }
}
